# =============================================================================
# THE MORNING DESK — environment template
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# MODEL EXECUTION
# -----------------------------------------------------------------------------
# cli = run generation through the Claude Code CLI against your Claude Pro or
#       Max subscription. Zero marginal cost per run. Requires the CLI to be
#       installed and logged in (`claude login`), or CLAUDE_CODE_OAUTH_TOKEN set.
# api = metered Anthropic API credits. Used automatically as a fallback.
LLM_BACKEND=cli

# Model alias handed to the CLI. Leave blank for the CLI default.
CLAUDE_CLI_MODEL=sonnet

# Only needed in CI, where there is no interactive login. Generate locally with:
#   claude setup-token
# then store the result as a GitHub Actions repository secret.
CLAUDE_CODE_OAUTH_TOKEN=

# Fallback API path. Optional; the pipeline ships a deterministic edition if no
# model backend is reachable at all.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096
LLM_TIMEOUT_SEC=300
LLM_RETRIES=2

# -----------------------------------------------------------------------------
# EDITORIAL
# -----------------------------------------------------------------------------
# newsletter = full issue with written desk stories
# data       = deterministic numbers-only edition, zero model calls
BRIEFING_MODE=newsletter

# Second model pass that checks every figure against the computed fact sheet
# and strips anything unsupported. Roughly doubles calls per run.
VERIFY_SECTIONS=true

# Words per group story. Lead sections carry their own larger budgets.
COVERAGE_STORY_WORDS=200
PRODUCT_STORY_WORDS=180

# Comma-separated group keys to omit entirely. Valid keys:
#   tmt, healthcare, industrials, consumer, energy_power, fig,
#   ma, ecm, dcm, levfin, sponsors, restructuring,
#   geopolitical, what_to_watch
SKIP_GROUPS=

# -----------------------------------------------------------------------------
# DATA SOURCES
# -----------------------------------------------------------------------------
# REQUIRED. 32-character key from https://fredaccount.stlouisfed.org/apikeys
# Without it the entire rates, funding, credit and macro core is missing.
FRED_API_KEY=

# Recommended. Free tier at https://finnhub.io — powers the earnings calendar,
# economic calendar, and merger news feed.
FINNHUB_API_KEY=

# Optional. https://newsapi.org — note the free tier is development-only under
# their terms, so the pipeline treats it as a supplementary source and works
# fine without it.
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# DELIVERY
# -----------------------------------------------------------------------------
# SendGrid is tried first, SMTP second. Configure at least one.
SENDGRID_API_KEY=

SENDER_EMAIL=
SENDER_NAME=The Morning Desk
RECIPIENT_EMAILS=you@example.com,someone@example.com
ADMIN_EMAIL=

# SMTP fallback. For Gmail, SMTP_PASSWORD must be an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# SCHEDULE
# -----------------------------------------------------------------------------
TIMEZONE=America/New_York
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
WEEKDAYS_ONLY=true

# -----------------------------------------------------------------------------
# FOOTER
# -----------------------------------------------------------------------------
UNSUBSCRIBE_URL=mailto:unsubscribe@example.com
